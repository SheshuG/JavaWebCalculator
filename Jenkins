pipeline {
  agent any

  tools {
    jdk 'JDK17'
    maven 'my-maven'
  }

  environment {
    SONARQUBE = 'SonarQube'
  }

  stages {
    stage('Clone') {
            steps {
                git branch: 'main', url: 'https://github.com/SheshuG/JavaWebCalculator.git'
      }
    }

    stage('Build') {
      steps {
        sh 'mvn clean install'
      }
    }

    stage('SonarQube Analysis') {
      steps {
        withSonarQubeEnv('SonarQube') {
          sh " mvn clean verify sonar:sonar \
  -Dsonar.projectKey=helo \
  -Dsonar.projectName='56789' \
  -Dsonar.host.url=http://54.234.175.243:9000 \
  -Dsonar.token=sqp_aab0ce24c8625106ef5d8a4c1ea1ab7d229314d6"
        }
      }
    }
  }
}

