pipeline {
  agent any

  tools {
    jdk 'JDK17'
    maven 'my-maven'
  }

  environment {
    SONARQUBE = 'SonarQube'
  }

  stages {
    stage('Clone') {
            steps {
                git branch: 'main', url: 'https://github.com/SheshuG/JavaWebCalculator.git'
      }
    }

    stage('Build') {
      steps {
        sh 'mvn clean install'
      }
    }

    stage('SonarQube Analysis') {
      steps {
        withSonarQubeEnv('SonarQube') {
          sh " mvn clean verify sonar:sonar \
  -Dsonar.projectKey=Test \
  -Dsonar.projectName='Test' \
  -Dsonar.host.url=http://54.234.175.243:9000 \
  -Dsonar.token=sqp_c71c6e73c5e47a04807d50c3da79fa0b715db2be"
        }
      }
    }
  }
}

