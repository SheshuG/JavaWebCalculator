pipeline {
  agent any

  tools {
    jdk 'JDK17'
    maven 'my-maven'
  }

  environment {
    SONARQUBE = 'SonarQube'
  }

  stages {
    stage('Checkout') {
      steps {
        git 'https://github.com/SheshuG/JavaWebCalculator.git'
      }
    }

    stage('Build') {
      steps {
        sh 'mvn clean install'
      }
    }

    stage('SonarQube Analysis') {
      steps {
        withSonarQubeEnv('SonarQube') {
          sh 'mvn sonar:sonar'
        }
      }
    }
  }
}

