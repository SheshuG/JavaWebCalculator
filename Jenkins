pipeline {
  agent any

  tools {
    jdk 'JDK17'
    maven 'my-maven'
  }

  environment {
    SONARQUBE = 'SonarQube'
  }

  stages {
    stage('Clone') {
            steps {
                git branch: 'main', url: 'https://github.com/SheshuG/JavaWebCalculator.git'
      }
    }

    stage('Build') {
      steps {
        sh 'mvn clean install'
      }
    }

    stage('SonarQube Analysis') {
      steps {
        withSonarQubeEnv('SonarQube') {
          sh "${mvn}/bin/mvn clean verify sonar:sonar -Dsonar.projectKey=Test -Dsonar.projectName='Test'"
        }
      }
    }
  }
}

